{
  "productName": "HMP",
  "version": "../package.json",
  "identifier": "fr.tktprod.hyperdeck-media-puller.v2.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HMP",
        "width": 1280,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#09090b",
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["preview"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": ["../../../build/icon.png", "../../../build/icon.ico", "../../../build/icon.icns"],
    "resources": {
      "../../../LICENSE": "licenses/HMP-MIT.txt",
      "../licenses/": "licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "bundleVersion": "1"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../../../build/icon.ico",
        "uninstallerIcon": "../../../build/icon.ico"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
